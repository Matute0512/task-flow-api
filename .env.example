# ==============================================
# Configuración General de la Aplicación
# ==============================================
APP_NAME="TaskFlow API"
APP_VERSION="1.0.0"
DEBUG=False

# ==============================================
# Base de Datos
# ==============================================
# Para desarrollo local rápido con SQLite:
# DATABASE_URL=sqlite:///./taskflow.db

# Para entorno Docker / Producción con PostgreSQL:
DATABASE_URL=postgresql://taskflow_user:secure_password_123@localhost:5432/taskflow_db

# Parámetros para Docker Compose (opcionales, tienen valores por defecto)
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=secure_password_123
POSTGRES_DB=taskflow_db
POSTGRES_PORT=5432
API_PORT=8000

# ==============================================
# Seguridad y Autenticación JWT
# ==============================================
# Generar una clave segura con: openssl rand -hex 32
SECRET_KEY=super-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30